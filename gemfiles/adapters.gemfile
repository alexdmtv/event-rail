source "https://rubygems.org"

# Third-party conformance, on one current stable Ruby and Rails combination. The gems
# here are the adapters and instrumentation the suite actually exercises; nothing is
# listed speculatively.
#
# json is pinned below 3.0 because `ActiveSupport::JSON.encode` still passes
# `quirks_mode:` to `JSON.generate`, which json 3.0 removed. Active Record's JSON column
# coder goes through that path, so Solid Queue cannot write a job row with json 3
# installed. Nothing in EventRail is involved -- it writes no JSON columns -- but the
# Solid Queue leg of this bundle needs a combination that works.
gem "activejob", "~> 8.1.0"
gem "activerecord", "~> 8.1.0"
gem "minitest", "~> 6.0"
gem "minitest-mock", "~> 5.27"
gem "sqlite3", ">= 2.1"
gem "json", "~> 2.7"

# require: false throughout: the fixture application must not load an adapter or an
# instrumentation library at boot just because it is in the bundle. Solid Queue's engine
# needs Active Record, which the fixture deliberately does not have, and the conformance
# tests require what they exercise explicitly.
gem "sidekiq", ">= 7", "< 9", require: false
gem "solid_queue", ">= 1.1", "< 3", require: false

gem "opentelemetry-sdk", "~> 1.8", require: false
gem "opentelemetry-instrumentation-active_job", "~> 0.7", require: false

gemspec path: "../"
