source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.4"

# The gem this application demonstrates, always from the repository's own source.
gem "event_rail", path: "../.."
# Use sqlite3 as the database for Active Record
gem "sqlite3", ">= 2.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
# gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Jobs and EventRail subscriber deliveries, stored in their own database [https://github.com/rails/solid_queue]
gem "solid_queue"

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Metrics: each module declares its own; the adapter a deployment adds exports them [https://github.com/yabeda-rb/yabeda]
gem "yabeda"
gem "yabeda-rails"
gem "yabeda-activejob"
# Registers its adapter when loaded, so only an environment that chooses it loads it
gem "yabeda-prometheus", require: false

# Traces, exported over OTLP [https://opentelemetry.io/docs/languages/ruby/]
gem "opentelemetry-sdk"
gem "opentelemetry-exporter-otlp"
gem "opentelemetry-instrumentation-rack"
gem "opentelemetry-instrumentation-action_pack"
gem "opentelemetry-instrumentation-active_record"
gem "opentelemetry-instrumentation-active_job"
gem "opentelemetry-instrumentation-active_support"
gem "opentelemetry-instrumentation-net_http"

group :development, :test do
  # Module boundaries, checked statically [https://github.com/Shopify/packwerk]
  gem "packwerk", require: false
  gem "packwerk-extensions", require: false

  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
end
