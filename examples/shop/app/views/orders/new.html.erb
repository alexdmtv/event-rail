<% content_for :title, "New order" %>

<section class="intro">
  <h1>Place an order</h1>
  <p>Checkout prices the basket, reserves the stock and authorizes the card before it answers -- synchronously, because
    the customer is waiting. The form carries a checkout key: submit it twice and you still get one order.</p>
</section>

<section class="card">
  <%= form_with url: orders_path, class: "checkout", data: { controller: "double-submit" } do |form| %>
    <%= form.hidden_field :checkout_key, value: @checkout_key %>
    <label>Customer
      <%= form.select :customer_id, @customers.map { |customer| [ "#{customer.name} (#{customer.email})", customer.id ] }, {}, class: "wide" %>
    </label>
    <table class="products">
      <thead><tr><th>Product</th><th class="number">Price</th><th class="number">Available</th><th class="number">Quantity</th></tr></thead>
      <tbody>
        <% @products.each_with_index do |product, index| %>
          <tr>
            <td><%= product.name %> <span class="muted small"><%= product.sku %></span></td>
            <td class="number"><%= money(product.price_cents) %></td>
            <td class="number"><%= product.available %></td>
            <td class="number"><%= number_field_tag "items[#{product.sku}]", index.zero? ? 1 : 0, min: 0, max: product.available, class: "quantity" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="actions">
      <%= form.submit "Place order", class: "button primary" %>
      <button type="button" class="button" data-action="double-submit#submit">Submit it twice at once</button>
      <span class="result" data-double-submit-target="result"></span>
    </div>
  <% end %>
</section>
